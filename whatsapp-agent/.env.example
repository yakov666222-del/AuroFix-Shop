# העתק את הקובץ הזה ל-.env ומלא את הפרטים

# מפתח API של Claude - מקבלים ב- https://platform.claude.com (Settings > API Keys)
ANTHROPIC_API_KEY=

# השם שלך ושם העסק (הסוכן מציג את עצמו כעוזר שלך)
OWNER_NAME=יעקב
BUSINESS_NAME=AuroFix

# כמה דקות הסוכן שותק בצ'אט אחרי שענית בו בעצמך
TAKEOVER_MINUTES=60

# כמה שניות לחכות לפני תשובה (כדי לאסוף כמה הודעות רצופות)
DEBOUNCE_SECONDS=6

# הגבלת תשובות אוטומטיות לכל צ'אט בשעה
MAX_REPLIES_PER_HOUR=20

# פורט לעמוד ה-QR, וסיסמה לעמוד (מומלץ כשמריצים על שרת: http://server:3000/?key=...)
PORT=3000
QR_PAGE_KEY=

# אזור זמן
TZ_NAME=Asia/Jerusalem
